{
  "Phase7": {
    "MinimumSendVersion": "0.7.0",
    "MicrosoftGraph": {
      "EmailSendEnabled": false
    }
  },
  "Phase8": {
    "MinimumSendVersion": "0.8.0",
    "Gmail": {
      "EmailSendEnabled": false
    }
  },
  "Phase10": {
    "MinimumSupportedVersion": "0.12.0",
    "EmailSendEnabled": false,
    "BetaChannelEnabled": true,
    "StableChannelEnabled": false
  },
  "Phase11": {
    "Enabled": true,
    "EnvironmentName": "staging",
    "AllowTest": true,
    "AllowDraft": true,
    "AllowSend": false,
    "RequireNonProductionData": true,
    "MaximumClients": 5
  },
  "Phase12": {
    "Enabled": false,
    "EnvironmentName": "production",
    "Stage": "Closed",
    "PilotApproved": false,
    "AllowSend": false,
    "StableReleaseApproved": false,
    "BackupRestoreDrillCompleted": false,
    "MonitoringReady": false,
    "IncidentResponseReady": false,
    "SupportReady": false,
    "MaximumBatchSize": 5,
    "MaximumDailySends": 20,
    "MinimumApplicationVersion": "0.12.0",
    "AllowedRoles": "OwnerTechnical,Administrator,Manager"
  },
  "Authentication": {
    "EnableDevelopmentScheme": false
  },
  "Database": {
    "Initialize": false,
    "Provider": "PostgreSql"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
