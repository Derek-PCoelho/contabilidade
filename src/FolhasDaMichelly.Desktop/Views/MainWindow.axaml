<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FolhasDaMichelly.Desktop.ViewModels"
        xmlns:ui="using:FolhasDaMichelly.Desktop.Models"
        xmlns:contracts="using:FolhasDaMichelly.Contracts.Clients"
        xmlns:documents="using:FolhasDaMichelly.Contracts.Documents"
        xmlns:dispatch="using:FolhasDaMichelly.Contracts.Dispatch"
        xmlns:incidents="using:FolhasDaMichelly.Application.Incidents"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="FolhasDaMichelly.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1500"
        d:DesignHeight="920"
        Width="1360"
        Height="860"
        MinWidth="960"
        MinHeight="640"
        Background="#F3F0E9"
        Icon="/Assets/Branding/logo1.png"
        Title="Folhas da Michelly">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ui:FriendlyTextConverter x:Key="FriendlyText" />
        <ui:LocalDateTimeConverter x:Key="LocalDateTime" />
        <ui:ShortIdentifierConverter x:Key="ShortIdentifier" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#211F1A" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#29261F" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9A741D" />
            <Setter Property="LetterSpacing" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#514C42" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#716B60" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DED9CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.soft">
            <Setter Property="Background" Value="#F8F5EE" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="Foreground" Value="#25231E" />
            <Setter Property="BorderBrush" Value="#D8D2C6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="Foreground" Value="#25231E" />
            <Setter Property="BorderBrush" Value="#D8D2C6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#9B7114" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2B2924" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#F1EDE4" />
            <Setter Property="Foreground" Value="#39352D" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FFF4F1" />
            <Setter Property="Foreground" Value="#8B3529" />
            <Setter Property="BorderBrush" Value="#D7A69D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E3D8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#302E29" />
        </Style>
        <Style Selector="ListBox.clean">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="PathIcon.navIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="#E8E3D8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.stepCircle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#E9E4DA" />
        </Style>
        <Style Selector="Border.stepCircle.current">
            <Setter Property="Background" Value="#D4A537" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Foreground" Value="#2B2822" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="204,*">
        <Border Background="#1B1A17" Padding="16,20,16,16">
            <Grid RowDefinitions="Auto,24,*,Auto">
                <Grid ColumnDefinitions="52,*" ColumnSpacing="10">
                    <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True"
                            Background="#C89A2B" BorderBrush="#E3C77F" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="M" FontSize="22" FontWeight="Bold" Foreground="#211B0D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="/Assets/Branding/logo1.png" Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   AutomationProperties.Name="Retrato de Michelly" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Folhas da" Foreground="#AFA99D" FontSize="12" />
                        <TextBlock Text="Michelly" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="MENU" Foreground="#777167" FontSize="10" FontWeight="SemiBold" Margin="13,0,0,8" />

                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsHomeSection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowHomeCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                                <TextBlock Grid.Column="1" Text="Início" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsClientsSection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowClientsCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C7.58,14 4,15.79 4,18V20H20V18C20,15.79 16.42,14 12,14Z" />
                                <TextBlock Grid.Column="1" Text="Clientes" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsDocumentsSection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowDocumentsCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M14,2H6C4.9,2 4,2.9 4,4V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2M13,9V3.5L18.5,9H13M8,13H16V15H8V13M8,17H16V19H8V17Z" />
                                <TextBlock Grid.Column="1" Text="Documentos" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsDispatchSection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowDispatchCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.89 21.1,4 20,4Z" />
                                <TextBlock Grid.Column="1" Text="Envios" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsReportsSection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowReportsCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M3,3V21H21V3H3M8,19H5V10H8V19M13,19H10V5H13V19M19,19H15V13H19V19Z" />
                                <TextBlock Grid.Column="1" Text="Relatórios" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsHistorySection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowHistoryCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3C8.03,3 4,7.03 4,12H1L5,16L9,12H6C6,8.13 9.13,5 13,5C16.87,5 20,8.13 20,12C20,15.87 16.87,19 13,19C11.07,19 9.32,18.22 8.05,16.95L6.63,18.37C8.27,20 10.5,21 13,21C17.97,21 22,16.97 22,12C22,7.03 17.97,3 13,3Z" />
                                <TextBlock Grid.Column="1" Text="Histórico" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="4,*">
                        <Border IsVisible="{Binding IsSettingsSection}" Background="#D4A537" CornerRadius="2" />
                        <Button Grid.Column="1" Classes="nav" Command="{Binding ShowSettingsCommand}">
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                <PathIcon Classes="navIcon" Data="M12,15.5C10.07,15.5 8.5,13.93 8.5,12C8.5,10.07 10.07,8.5 12,8.5C13.93,8.5 15.5,10.07 15.5,12C15.5,13.93 13.93,15.5 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.42,11L21.54,9.37L19.54,5.9L17.05,6.9C16.54,6.5 16,6.16 15.38,5.92L15,3.27H11L10.62,5.92C10,6.16 9.46,6.5 8.95,6.9L6.46,5.9L4.46,9.37L6.58,11C6.53,11.34 6.5,11.67 6.5,12C6.5,12.33 6.53,12.65 6.58,12.97L4.46,14.63L6.46,18.1L8.95,17.1C9.46,17.5 10,17.84 10.62,18.08L11,20.73H15L15.38,18.08C16,17.84 16.54,17.5 17.05,17.1L19.54,18.1L21.54,14.63L19.43,12.97Z" />
                                <TextBlock Grid.Column="1" Text="Configurações" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="3" Background="#25231F" CornerRadius="10" Padding="10">
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="10">
                        <Border Width="48" Height="44" CornerRadius="7" ClipToBounds="True" Background="#0E0E0D">
                            <Grid>
                                <TextBlock Text="60" Foreground="#D4A537" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="/Assets/Branding/aaa2.png" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       AutomationProperties.Name="Marca Contadores Associados" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Contadores" Foreground="#F0ECE3" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Associados" Foreground="#8E887D" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="108,*,64">
            <Border Background="#FFFFFF" BorderBrush="#DDD8CE" BorderThickness="0,0,0,1" Padding="24,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                    <StackPanel Spacing="3" MaxWidth="470" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="{Binding SectionTitle}" AutomationProperties.HeadingLevel="1" />
                        <TextBlock Classes="muted" Text="{Binding SectionDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F6F2E9" BorderBrush="#E1DBCF" BorderThickness="1"
                            CornerRadius="13" Padding="12,9" VerticalAlignment="Center" Width="400">
                        <Grid ColumnDefinitions="*,104,118" ColumnSpacing="10">
                            <Border Width="4" Background="#D9A400" CornerRadius="2" HorizontalAlignment="Left" />
                            <StackPanel Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="COMPETÊNCIA" FontSize="10" FontWeight="SemiBold" Foreground="#9A741D" />
                                <TextBlock Text="{Binding WorkPeriodLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#4D473D" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="ANO" FontSize="9" Foreground="#756D60" />
                                <ComboBox ItemsSource="{Binding OperationalYears}" SelectedItem="{Binding SelectedOperationalYear}" MinHeight="36" AutomationProperties.Name="Ano da competência">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:OperationalYearOption"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="MÊS" FontSize="9" Foreground="#756D60" />
                                <ComboBox ItemsSource="{Binding OperationalMonths}" SelectedItem="{Binding SelectedOperationalMonth}" MinHeight="36" AutomationProperties.Name="Mês da competência">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:OperationalMonthOption"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer IsVisible="{Binding IsHomeSection}" AutomationProperties.Name="Conteúdo inicial">
                    <StackPanel Margin="28" Spacing="18">
                        <Border IsVisible="{Binding ShowEmailSetupNotice}" Background="#FFF5E4" BorderBrush="#E5C36B"
                                BorderThickness="1" CornerRadius="12" Padding="14,11">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                <PathIcon Width="20" Height="20" Foreground="#A47213" VerticalAlignment="Center"
                                          Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M11,7H13V13H11V7M11,15H13V17H11V15Z" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding EmailSetupNoticeTitle}" FontWeight="SemiBold" Foreground="#5D451A" />
                                    <TextBlock Text="{Binding EmailSetupNoticeText}"
                                               Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="ghost" Content="Ir para conexão" Command="{Binding ShowEmailSettingsCommand}" />
                            </Grid>
                        </Border>
                        <Border CornerRadius="18" Background="#2A2823" Padding="26" ClipToBounds="True">
                            <Grid ColumnDefinitions="3*,220" ColumnSpacing="28">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="BOM TRABALHO, MICHELLY" Foreground="#D9B453" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Tudo o que precisa, na ordem certa." Foreground="#FFFFFF"
                                               FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Cadastre o cliente, importe os documentos, confira as pendências e só então prepare as mensagens."
                                               Foreground="#C9C3B8" FontSize="13" TextWrapping="Wrap" MaxWidth="760"
                                               HorizontalAlignment="Left" TextAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                        <Button Classes="primary" Content="Importar documentos" Command="{Binding ShowDocumentsCommand}" />
                                        <Button Classes="ghost" Content="Cadastrar cliente" Command="{Binding NewClientCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Height="128" CornerRadius="13" ClipToBounds="True" Background="#3A3730">
                                    <Grid>
                                        <TextBlock Text="Nosso escritório" Foreground="#D9B453" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="/Assets/Branding/aaa1.png" Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                               AutomationProperties.Name="Equipe do escritório" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                            <Border Classes="card">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="eyebrow" Text="DOCUMENTOS" />
                                    <TextBlock Text="{Binding VisibleDocumentCount}" FontSize="30" FontWeight="SemiBold" Foreground="#28251F" />
                                    <TextBlock Classes="muted" Text="documentos na competência selecionada" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="eyebrow" Text="PRECISAM DE ATENÇÃO" />
                                    <TextBlock Text="{Binding BlockedDocumentCount}" FontSize="30" FontWeight="SemiBold" Foreground="#A14C3A" />
                                    <TextBlock Classes="muted" Text="bloqueados ou repetidos" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="eyebrow" Text="APROVADOS" />
                                    <TextBlock Text="{Binding ApprovedGroupCount}" FontSize="30" FontWeight="SemiBold" Foreground="#477945" />
                                    <TextBlock Classes="muted" Text="conjuntos liberados para mensagem" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="h2" Text="Seu fluxo de trabalho" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                                            <Border Classes="stepCircle"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                            <TextBlock Text="Cadastrar cliente" TextAlignment="Center" TextWrapping="Wrap" Foreground="#4B463D" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="6">
                                            <Border Classes="stepCircle"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                            <TextBlock Text="Conferir documentos" TextAlignment="Center" TextWrapping="Wrap" Foreground="#4B463D" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                                            <Border Classes="stepCircle"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                            <TextBlock Text="Preparar mensagens" TextAlignment="Center" TextWrapping="Wrap" Foreground="#4B463D" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="6">
                                            <Border Classes="stepCircle"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                            <TextBlock Text="Concluir e relatar" TextAlignment="Center" TextWrapping="Wrap" Foreground="#4B463D" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="muted" Text="O aplicativo preserva as travas de segurança nos bastidores e organiza cada decisão na ordem certa." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="9">
                                    <TextBlock Classes="h2" Text="Atalhos" />
                                    <Button Classes="ghost" Content="Consultar clientes cadastrados" Command="{Binding ShowClientsCommand}" HorizontalAlignment="Stretch" />
                                    <Button Classes="ghost" Content="Revisar documentos" Command="{Binding ShowDocumentsCommand}" HorizontalAlignment="Stretch" />
                                    <Button Classes="ghost" Content="Preparar mensagens" Command="{Binding ShowDispatchCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsClientsSection}" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Cadastro de clientes">
                    <StackPanel Margin="20" Spacing="14">
                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <StackPanel>
                                    <TextBlock Classes="h2" Text="Clientes cadastrados" />
                                    <TextBlock Classes="muted" Text="Clique em um cliente para abrir e atualizar o cadastro." TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Content="{Binding ClientListPanelActionLabel}"
                                        Command="{Binding ToggleClientListPanelCommand}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="primary" Content="Novo cliente" Command="{Binding NewClientCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid IsVisible="{Binding IsClientListPanelExpanded}" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBox Name="ClientSearchTextBox" PlaceholderText="Buscar por nome, CPF ou CNPJ e pressionar Enter"
                                         Text="{Binding SearchText}" KeyDown="ClientSearch_KeyDown" />
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                    <CheckBox Content="Mostrar inativos" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Content="Ocultar CPF/CNPJ na lista" IsChecked="{Binding MaskClientTaxIds}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="ghost" Content="Buscar" Command="{Binding LoadClientsCommand}" HorizontalAlignment="Right" />
                                </Grid>
                                <ListBox Grid.Row="2" Classes="clean" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                                         SelectionChanged="ClientList_SelectionChanged" AutomationProperties.Name="Clientes cadastrados" MaxHeight="230">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ui:ClientListRow">
                                        <Border Background="#F8F5EE" BorderBrush="#E5DFD4" BorderThickness="1" Padding="11" Margin="0,0,0,7" CornerRadius="9">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#29261F" TextTrimming="CharacterEllipsis" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding TaxIdDisplay}" Foreground="#736C60" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Ativo" IsVisible="{Binding IsActive}" Foreground="#2F7A43" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="Inativo" IsVisible="{Binding !IsActive}" Foreground="#7B6B59" FontSize="12" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                        <StackPanel Spacing="14" Margin="0,0,4,16">
                            <Border Classes="card">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="11">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel>
                                            <TextBlock Classes="h2" Text="{Binding ClientEditorTitle}" />
                                            <TextBlock Classes="muted" Text="{Binding ReadinessMessage}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" Content="{Binding ClientEditorPanelActionLabel}"
                                                Command="{Binding ToggleClientEditorPanelCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                               IsVisible="{Binding IsClientEditorPanelExpanded}">
                                        <Border Background="{Binding ClientStatusBackground}" CornerRadius="14" Padding="11,7" Margin="0,0,8,8"
                                                IsVisible="{Binding HasExistingClient}">
                                            <TextBlock Text="{Binding ClientStatusLabel}" Foreground="{Binding ClientStatusForeground}" FontWeight="SemiBold" />
                                        </Border>
                                        <Button Classes="danger" Content="{Binding ClientArchiveActionLabel}" Command="{Binding ArchiveClientCommand}"
                                                IsVisible="{Binding HasExistingClient}" Margin="0,0,8,8" />
                                        <Button Classes="ghost" Content="{Binding ClientStatusActionLabel}" Command="{Binding ToggleClientActiveCommand}"
                                                IsVisible="{Binding HasExistingClient}" Margin="0,0,8,8" />
                                        <Button Classes="primary" Content="{Binding ClientSaveActionLabel}" Command="{Binding SaveClientCommand}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="14" IsVisible="{Binding IsClientEditorPanelExpanded}">

                            <Border Background="{Binding ClientFeedbackBackground}" BorderBrush="{Binding ClientFeedbackBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="13,10"
                                    IsVisible="{Binding HasClientFeedback}" AutomationProperties.LiveSetting="Assertive">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <TextBlock Text="{Binding ClientFeedbackIcon}" Foreground="{Binding ClientFeedbackForeground}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ClientFeedbackMessage}" Foreground="{Binding ClientFeedbackForeground}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="eyebrow" Text="1 · DADOS ESSENCIAIS" />
                                        <TextBlock Classes="h2" Text="Quem é este cliente?" />
                                        <TextBlock Classes="muted" Text="Estes são os únicos dados obrigatórios para identificar corretamente a empresa ou pessoa." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Tipo de cliente" />
                                            <ComboBox ItemsSource="{Binding PersonTypes}" SelectedItem="{Binding SelectedPersonType}" IsEnabled="{Binding CanChangePersonType}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="label" Text="{Binding PrimaryTaxIdLabel}" />
                                            <TextBox Text="{Binding PrimaryTaxId}" PlaceholderText="{Binding PrimaryTaxIdPlaceholder}" />
                                            <TextBlock Classes="muted" Text="{Binding PrimaryTaxIdHelp}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                            <TextBlock Classes="label" Text="{Binding LegalNameLabel}" />
                                            <TextBox Text="{Binding LegalName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" IsVisible="{Binding IsLegalEntity}">
                                            <TextBlock Classes="label" Text="Nome fantasia (opcional)" />
                                            <TextBox Text="{Binding PreferredName}" PlaceholderText="Ex.: Loja Primavera" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsLegalEntity}">
                                            <TextBlock Classes="label" Text="Código no sistema contábil (opcional)" />
                                            <TextBox Text="{Binding InternalCode}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" IsVisible="{Binding IsLegalEntity}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="eyebrow" Text="SÓCIOS E REPRESENTANTES · OPCIONAL" />
                                        <TextBlock Classes="h2" Text="Quem representa esta empresa?" />
                                        <TextBlock Classes="muted" Text="Informe somente quando for útil ao cadastro. O CPF do sócio nunca será usado para associar um documento à empresa." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
                                        <TextBox PlaceholderText="Nome completo do sócio ou representante" Text="{Binding NewPartnerName}" />
                                        <TextBox Grid.Column="1" PlaceholderText="CPF (opcional)" Text="{Binding NewPartnerCpf}" />
                                        <TextBox Grid.Row="1" PlaceholderText="E-mail do representante (opcional)" Text="{Binding NewPartnerEmail}" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PartnerRoles}" SelectedItem="{Binding SelectedPartnerRole}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="Usar também como contato de entrega" IsChecked="{Binding UsePartnerAsDeliveryContact}" />
                                        <Border Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding HasPartnerInputError}"
                                                Background="#FFF0ED" BorderBrush="#D99A8C" BorderThickness="1"
                                                CornerRadius="9" Padding="10,8">
                                            <TextBlock Text="{Binding PartnerInputError}" Foreground="#7A3328"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                        <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Classes="primary" Content="Adicionar representante" Command="{Binding AddPartnerCommand}" />
                                    </Grid>
                                    <ListBox Classes="clean" ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner}" MaxHeight="170">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:ClientPartnerModel">
                                                <Border Classes="soft" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#29261F" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Role, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" />
                                                        <TextBlock Grid.Row="1" Text="{Binding Email, TargetNullValue='E-mail não informado'}" Foreground="#766F62" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cpf, TargetNullValue='CPF não informado'}" Foreground="#766F62" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Classes="ghost" HorizontalAlignment="Right" Content="Remover selecionado" Command="{Binding RemovePartnerCommand}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="13">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="eyebrow" Text="2 · CONTATO DE ENTREGA" />
                                        <TextBlock Classes="h2" Text="Quem recebe os documentos?" />
                                        <TextBlock Classes="muted" Text="Na maioria dos casos, basta o e-mail da própria empresa. Adicione outros somente quando houver uma necessidade real de cópia." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="9">
                                        <TextBox PlaceholderText="Nome do contato ou setor" Text="{Binding NewRecipientName}" />
                                        <TextBox Grid.Column="1" PlaceholderText="email@empresa.com.br" Text="{Binding NewRecipientEmail}" />
                                        <ComboBox Grid.Row="1" ItemsSource="{Binding DeliveryRoles}" SelectedItem="{Binding SelectedDeliveryRole}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Classes="primary" Content="Adicionar contato" Command="{Binding AddRecipientCommand}" />
                                    </Grid>
                                    <ListBox Classes="clean" ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}" MaxHeight="200">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:RecipientModel">
                                                <Border Classes="soft" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#29261F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="1" Text="{Binding Email}" Foreground="#6E675B" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DeliveryRole, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="E-mail principal" IsVisible="{Binding IsPrimary}" Foreground="#2F7A43" FontSize="12" FontWeight="SemiBold" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Classes="ghost" HorizontalAlignment="Right" Content="Remover contato selecionado" Command="{Binding RemoveRecipientCommand}" />
                                </StackPanel>
                            </Border>

                            <Expander Header="Filiais ou estabelecimentos (somente se houver)" Padding="16" CornerRadius="12" IsVisible="{Binding IsLegalEntity}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Classes="muted" Text="Use esta seção quando um mesmo cliente possui matriz e filiais com CNPJs próprios. Isso evita associar o documento à unidade errada." TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBox PlaceholderText="CNPJ da unidade" Text="{Binding NewEstablishmentCnpj}" />
                                        <TextBox Grid.Column="1" PlaceholderText="Nome da matriz ou filial" Text="{Binding NewEstablishmentName}" />
                                        <Button Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Classes="primary" Content="Adicionar unidade" Command="{Binding AddEstablishmentCommand}" />
                                    </Grid>
                                    <ListBox Classes="clean" ItemsSource="{Binding Establishments}" SelectedItem="{Binding SelectedEstablishment}" MaxHeight="190">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:EstablishmentModel">
                                                <Border Classes="soft" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="220,*,Auto">
                                                        <TextBlock Text="{Binding Cnpj}" Foreground="#8C691B" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#29261F" />
                                                        <TextBlock Grid.Column="2" Text="Matriz" IsVisible="{Binding IsHeadOffice}" Foreground="#2F7A43" FontSize="12" FontWeight="SemiBold" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Classes="ghost" HorizontalAlignment="Right" Content="Remover unidade selecionada" Command="{Binding RemoveEstablishmentCommand}" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Outros nomes e códigos usados nos documentos (opcional)" Padding="16" CornerRadius="12">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Classes="muted" Text="Cadastre aqui apenas aliases ou códigos adicionais que realmente aparecem nos documentos. O CPF ou CNPJ principal já foi informado acima." TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding IdentifierTypes}" SelectedItem="{Binding SelectedIdentifierType}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" PlaceholderText="Nome alternativo ou código" Text="{Binding NewIdentifierValue}" />
                                        <Button Grid.Column="2" Classes="primary" Content="Adicionar" Command="{Binding AddIdentifierCommand}" />
                                    </Grid>
                                    <ListBox Classes="clean" ItemsSource="{Binding Identifiers}" SelectedItem="{Binding SelectedIdentifier}" MaxHeight="170">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:ClientIdentifierModel">
                                                <Border Classes="soft" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="240,*">
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#29261F" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Classes="ghost" HorizontalAlignment="Right" Content="Remover item selecionado" Command="{Binding RemoveIdentifierCommand}" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Mensagem personalizada para este cliente (opcional)" Padding="16" CornerRadius="12">
                                <StackPanel Margin="0,12,0,0" Spacing="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="{Binding TemplateEditorTitle}" />
                                        <TextBlock Classes="muted" Text="Use somente quando este cliente precisa de uma mensagem diferente do padrão do escritório. O nome abaixo serve apenas para você localizar o modelo." TextWrapping="Wrap" />
                                        <Border Background="#F8F5EE" BorderBrush="#E2DDD3" BorderThickness="1" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Prefere começar com uma mensagem pronta?" />
                                                <TextBlock Classes="muted" Text="Escolha um texto neutro e profissional; depois você pode ajustar somente o necessário." TextWrapping="Wrap" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Classes="ghost" Content="Usar padrão para empresa" Command="{Binding ApplyLegalEntityStandardTemplateCommand}" Margin="0,0,8,8" />
                                                    <Button Classes="ghost" Content="Usar padrão para pessoa física" Command="{Binding ApplyNaturalPersonStandardTemplateCommand}" Margin="0,0,8,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Nome da mensagem" />
                                            <TextBox Text="{Binding TemplateName}" MaxLength="160" />
                                            <TextBlock Classes="muted" Text="{Binding TemplateNameLength, StringFormat='{}{0}/160 caracteres'}" HorizontalAlignment="Right" FontSize="10" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Assunto do e-mail" />
                                            <TextBox Text="{Binding TemplateSubject}" MaxLength="500" />
                                            <TextBlock Classes="muted" Text="{Binding TemplateSubjectLength, StringFormat='{}{0}/500 caracteres'}" HorizontalAlignment="Right" FontSize="10" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="label" Text="Adicionar informação variável sem decorar códigos" />
                                            <ComboBox ItemsSource="{Binding TemplatePlaceholderTargetOptions}"
                                                      SelectedItem="{Binding SelectedTemplatePlaceholderTarget}"
                                                      PlaceholderText="Escolha onde inserir: assunto ou texto" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="ghost" Content="Nome do cliente" Command="{Binding InsertClientNamePlaceholderCommand}" Margin="0,0,6,6" />
                                                <Button Classes="ghost" Content="Nome do contato" Command="{Binding InsertContactNamePlaceholderCommand}" Margin="0,0,6,6" />
                                                <Button Classes="ghost" Content="Competência" Command="{Binding InsertPeriodPlaceholderCommand}" Margin="0,0,6,6" />
                                                <Button Classes="ghost" Content="Lista de documentos" Command="{Binding InsertDocumentListPlaceholderCommand}" Margin="0,0,6,6" />
                                                <Button Classes="ghost" Content="Vencimentos" Command="{Binding InsertDueDatesPlaceholderCommand}" Margin="0,0,6,6" />
                                                <Button Classes="ghost" Content="Nome do escritório" Command="{Binding InsertOfficeNamePlaceholderCommand}" Margin="0,0,6,6" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Texto do e-mail" />
                                            <TextBox Text="{Binding TemplateBody}" AcceptsReturn="True" MinHeight="170" MaxLength="20000" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="{Binding TemplateBodyLength, StringFormat='{}{0}/20.000 caracteres'}" HorizontalAlignment="Right" FontSize="10" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Classes="ghost" Content="Começar nova" Command="{Binding NewTemplateCommand}" />
                                            <Button Grid.Column="1" Classes="primary" Content="{Binding TemplateSaveActionLabel}" Command="{Binding SaveTemplateCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="9">
                                        <TextBlock Classes="h2" Text="Mensagens deste cliente" />
                                        <TextBlock Classes="muted" Text="Selecionar não altera nada. Use Editar para carregar uma mensagem no formulário." TextWrapping="Wrap" />
                                    <ListBox Classes="clean" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MaxHeight="420">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:MessageTemplateModel">
                                                <Border Classes="soft" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#29261F" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="Ativa" IsVisible="{Binding IsActive}" Foreground="#2F7A43" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="Inativa" IsVisible="{Binding !IsActive}" Foreground="#7B6B59" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SubjectTemplate}" Foreground="#766F62" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button Classes="ghost" Content="Editar selecionada" Command="{Binding EditSelectedTemplateCommand}" />
                                        <Button Classes="ghost" Content="{Binding TemplateStatusActionLabel}" Command="{Binding ToggleTemplateActiveCommand}" IsEnabled="{Binding HasSelectedTemplate}" />
                                        <Button Classes="danger" Content="{Binding TemplateArchiveActionLabel}" Command="{Binding ArchiveTemplateCommand}" IsEnabled="{Binding HasSelectedTemplate}" />
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Border Classes="card">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="label" Text="Observações internas (opcional)" />
                                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="86" TextWrapping="Wrap" PlaceholderText="Informações úteis para o escritório; não serão incluídas automaticamente no e-mail." />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Classes="h2" Text="Concluir cadastro" />
                                        <TextBlock Classes="muted" Text="Confira os dados acima. Campos opcionais podem permanecer em branco." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="danger" Content="{Binding ClientArchiveActionLabel}" Command="{Binding ArchiveClientCommand}"
                                            IsVisible="{Binding HasExistingClient}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="primary" Content="{Binding ClientSaveActionLabel}" Command="{Binding SaveClientCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsDocumentsSection}" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Fluxo de documentos">
                    <StackPanel Margin="20" Spacing="14">
                        <Border Classes="card" Padding="14">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <Border Classes="stepCircle" Classes.current="{Binding IsDocumentImportStepCurrent}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Adicionar" FontWeight="SemiBold" />
                                        <TextBlock Text="Arquivos ou pasta" Classes="muted" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <Border Classes="stepCircle" Classes.current="{Binding IsDocumentReviewStepCurrent}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Conferir" FontWeight="SemiBold" />
                                        <TextBlock Text="Um documento por vez" Classes="muted" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <Border Classes="stepCircle" Classes.current="{Binding IsDocumentApprovalStepCurrent}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Liberar" FontWeight="SemiBold" />
                                        <TextBlock Text="Para preparar a mensagem" Classes="muted" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card" DragDrop.AllowDrop="True" DragDrop.DragOver="DocumentDropZone_DragOver" DragDrop.Drop="DocumentDropZone_Drop">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="eyebrow" Text="1 · ADICIONAR DOCUMENTOS" />
                                        <TextBlock Classes="h2" Text="Arraste PDFs aqui ou escolha os arquivos" />
                                        <TextBlock Classes="muted" Text="O aplicativo lê PDFs e organiza o acervo por competência. Limite: 25 MB e 100 páginas por documento." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Escolher PDFs" Click="ChoosePdfFiles_Click" VerticalAlignment="Center" />
                                </Grid>

                                <Expander Header="Usar uma pasta inteira" IsExpanded="{Binding IsDocumentImportPanelExpanded}" Padding="14" CornerRadius="10">
                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                        <TextBlock Classes="muted" Text="Escolha a pasta e o aplicativo importará os PDFs encontrados nela. Outros formatos permanecem no lugar e aparecem apenas no resumo." TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding InputFolderDisplay}" Foreground="#6E6254" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Escolher e importar pasta" Click="ChooseAndImportInputFolder_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <CheckBox Content="Incluir também as subpastas" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="ghost" Content="Importar novamente a pasta escolhida" Click="ImportInputFolder_Click"
                                                    IsVisible="{Binding HasConfiguredInputFolder}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Classes="muted" Text="{Binding DocumentImportSummary}" TextWrapping="Wrap" />
                                <Grid IsVisible="{Binding IsRecognizingDocuments}" ColumnDefinitions="*,Auto" ColumnSpacing="10" AutomationProperties.LiveSetting="Polite">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding DocumentImportProgressText}" Foreground="#6B604C" />
                                        <ProgressBar Minimum="0" Maximum="{Binding DocumentImportTotal}" Value="{Binding DocumentImportProgress}" Height="6" AutomationProperties.Name="Progresso da importação" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Interromper" Command="{Binding CancelDocumentImportCommand}" />
                                </Grid>
                                <Border IsVisible="{Binding HasHiddenReviewDocuments}" Background="#FFF8E8" BorderBrush="#E4C56C" BorderThickness="1" CornerRadius="10" Padding="11,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding HiddenReviewDocumentCount, StringFormat='{}{0} documento(s) estão fora da competência selecionada.'}" Foreground="#5E4A1E" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Classes="ghost" Content="Mostrar todos" Command="{Binding ShowAllPeriodsCommand}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="eyebrow" Text="2 · CONFERIR DOCUMENTOS" />
                                    <TextBlock Classes="h2" Text="Escolha um documento para ver a próxima ação" />
                                    <TextBlock Classes="muted" Text="{Binding ReviewWorkspaceSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WorkPeriodLabel}" Foreground="#8C691B" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>

                                <ListBox Classes="clean" ItemsSource="{Binding VisibleReviewDocuments}" SelectedItem="{Binding SelectedReviewDocument}"
                                         AutomationProperties.Name="Documentos da competência" MinHeight="110" MaxHeight="330">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="documents:ReviewDocument">
                                            <Border Background="#F8F5EE" BorderBrush="#E5DFD4" BorderThickness="1" Padding="11" Margin="0,0,0,7" CornerRadius="9">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#29261F" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DocumentType, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" />
                                                            <TextBlock Text="{Binding Period.DisplayLabel}" Foreground="#766F62" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ClientDisplayName, TargetNullValue='Cliente ainda não identificado'}" Foreground="#4F483E" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ClientTaxIdMasked}" Foreground="#766F62" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ReviewSummary}" Foreground="#5E594F" FontSize="11" TextWrapping="Wrap" MaxWidth="210" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border IsVisible="{Binding ShowReviewEmptyState}" Background="#F8F5EE" CornerRadius="9" Padding="12" IsHitTestVisible="False">
                                    <TextBlock Text="Nenhum documento deste período. Use “Mostrar todos” acima." TextWrapping="Wrap" Foreground="#6B604C" TextAlignment="Center" />
                                </Border>

                                <Expander Header="Mais opções para estes arquivos" Padding="12" CornerRadius="10">
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <TextBlock Classes="muted" Text="Use apenas se os cadastros ou as regras de leitura mudaram depois da importação." TextWrapping="Wrap" />
                                        <Button Classes="ghost" Content="Analisar novamente os documentos deste período" Command="{Binding RevalidateReviewCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding HasReviewSelection}">
                            <StackPanel Spacing="11">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="eyebrow" Text="DOCUMENTO SELECIONADO" />
                                        <TextBlock Classes="h2" Text="{Binding SelectedReviewDocument.FileName}" />
                                        <TextBlock Text="{Binding SelectedReviewDocument.DocumentType, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F1EDE4" Padding="12,8" CornerRadius="15" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedReviewDocument.State, Converter={StaticResource FriendlyText}}" Foreground="#5E594F" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedReviewDocument.BlockingFindingCount, StringFormat='Pendências: {0}'}" Foreground="#8E5549" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#F3EFE6" CornerRadius="10" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedDocumentClientSummary}" Foreground="#3F5F3D" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDocumentRecognitionMethodSummary}" Foreground="#6E6254" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedDocumentGroupingSummary}" Foreground="#5D574E" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Expander Header="{Binding SelectedGroupViewerHeader}"
                                          IsVisible="{Binding HasSelectedReviewGroupDocuments}"
                                          IsExpanded="False" Padding="12" CornerRadius="10">
                                    <StackPanel Spacing="7" Margin="0,9,0,0">
                                        <TextBlock Classes="muted"
                                                   Text="Estes arquivos pertencem ao mesmo cliente, unidade, competência e regra de mensagem. Conferir o conjunto não altera nenhuma aprovação."
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding SelectedReviewGroupDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="documents:ReviewDocument">
                                                    <Border Classes="soft" Margin="0,0,0,5">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                           Foreground="#29261F" TextTrimming="CharacterEllipsis" />
                                                                <WrapPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DocumentType, Converter={StaticResource FriendlyText}}"
                                                                               Foreground="#8C691B" Margin="0,0,10,0" />
                                                                    <TextBlock Text="{Binding Period.DisplayLabel}" Foreground="#766F62" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding State, Converter={StaticResource FriendlyText}}"
                                                                       Foreground="#5E594F" FontSize="11" VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" MaxWidth="170" TextAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>

                                <Border Background="#F7F1E2" CornerRadius="9" Padding="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Próxima ação" Foreground="#8B6514" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedDocumentGuidance}" Foreground="#4F483E" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SelectedReviewDocument.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="documents:ValidationFinding">
                                            <Border Background="#FFF6ED" BorderBrush="#E8D3BF" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Severity, Converter={StaticResource FriendlyText}}" Foreground="#96523D" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#4F483E" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Expander Header="Corrigir ou retirar o documento selecionado" Padding="16" CornerRadius="12"
                                  IsVisible="{Binding HasReviewSelection}" IsExpanded="{Binding IsDocumentCorrectionPanelExpanded}">
                            <StackPanel Spacing="14" Margin="0,12,0,0">
                                <TextBlock Classes="muted" Text="Abra esta área quando o cliente, a competência ou a importação precisarem de ajuste. Toda alteração revoga aprovações anteriores e fica registrada." TextWrapping="Wrap" />

                                <Border IsVisible="{Binding SelectedDocumentHasInactiveClientIssue}" Background="#FFF5E4" BorderBrush="#E5C36B" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Cadastro associado está inativo" FontWeight="SemiBold" Foreground="#6C4D11" />
                                            <TextBlock Classes="muted" Text="Abra o cadastro, reative-o e volte a Documentos. A conferência será refeita automaticamente." TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Abrir e reativar cadastro" Command="{Binding OpenInactiveClientFromDocumentCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="7" IsVisible="{Binding HasClientCorrectionAlternatives}">
                                    <TextBlock Classes="label" Text="Confirmar o cliente correto" />
                                    <TextBlock Classes="muted" Text="Escolha somente quando o PDF corresponde a uma das alternativas abaixo." TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding SelectedReviewDocument.ClientAlternatives}" SelectedItem="{Binding SelectedOverrideCandidate}" PlaceholderText="Escolha o cliente correto">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="documents:ClientResolutionCandidate"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding OverrideReason}" PlaceholderText="Motivo da confirmação (mínimo 10 caracteres)" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Confirmar cliente" Command="{Binding OverrideSelectedClientCommand}" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="#E5DFD4" />
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="label" Text="Corrigir competência" />
                                    <TextBlock Classes="muted" Text="Use somente quando o mês ou ano reconhecido não corresponde ao documento." TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <ComboBox ItemsSource="{Binding CorrectionYearOptions}" SelectedItem="{Binding SelectedCorrectionYear}" AutomationProperties.Name="Ano correto">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:OperationalYearOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding CorrectionMonthOptions}" SelectedItem="{Binding SelectedCorrectionMonth}" AutomationProperties.Name="Mês correto">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:OperationalMonthOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DocumentCorrectionReason}" PlaceholderText="Motivo da correção (mínimo 10 caracteres)" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Classes="ghost" Content="Voltar à competência reconhecida" Command="{Binding RestoreSelectedDocumentPeriodCommand}" IsEnabled="{Binding CanRestoreSelectedDocumentPeriod}" Margin="0,0,8,8" />
                                        <Button Classes="secondary" Content="Salvar competência correta" Command="{Binding CorrectSelectedDocumentPeriodCommand}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                </StackPanel>

                                <Border Height="1" Background="#E5DFD4" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="label" Text="Retirar este arquivo da conferência" />
                                        <TextBlock Classes="muted" Text="O PDF permanece no acervo. Você poderá importá-lo novamente para repetir o teste ou corrigir o período." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Classes="danger" Content="Retirar deste período" Command="{Binding BeginRemoveSelectedDocumentCommand}" Margin="0,0,8,8" />
                                        <Button Classes="ghost" Content="Retirar e testar de novo" Command="{Binding PrepareDocumentRetestRemovalCommand}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                </Grid>
                                <Border IsVisible="{Binding IsDocumentRemovalConfirmationVisible}" Background="#FFF0ED" BorderBrush="#D99A8C" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Confirmar retirada recuperável" FontWeight="SemiBold" Foreground="#7A3328" />
                                        <TextBlock Text="O PDF não será apagado. Informe por que este item saiu da conferência." Foreground="#6A4942" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding DocumentRemovalReason}" PlaceholderText="Ex.: importado na competência errada" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Classes="ghost" Content="Cancelar" Command="{Binding CancelRemoveSelectedDocumentCommand}" />
                                            <Button Classes="secondary" Content="Confirmar retirada" Command="{Binding ConfirmRemoveSelectedDocumentCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Border Classes="card" IsVisible="{Binding HasReviewSelection}">
                            <StackPanel Spacing="11">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="eyebrow" Text="3 · LIBERAR PARA A MENSAGEM" />
                                    <TextBlock Classes="h2" Text="Confirme somente depois de conferir" />
                                    <TextBlock Classes="muted" Text="Liberar não envia e-mail. Apenas autoriza estes documentos a seguirem para a preparação da mensagem." TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="Um conjunto reúne documentos do mesmo cliente, unidade e competência que podem seguir na mesma mensagem. Férias, rescisões e exceções permanecem separadas." TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Classes="soft">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedDocumentGroupingSummary}" Foreground="#4F483E" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedReviewGroupStatusSummary}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="primary" Content="{Binding SelectedSetApprovalLabel}" Command="{Binding ApproveSelectedGroupCommand}"
                                            IsEnabled="{Binding CanApproveSelectedReviewGroup}" Margin="0,0,8,8" />
                                    <Button Classes="secondary" Content="{Binding SelectedClientApprovalLabel}" Command="{Binding ApproveSelectedClientGroupsCommand}"
                                            IsVisible="{Binding ShowSelectedClientApproval}" IsEnabled="{Binding CanApproveSelectedClientGroups}" Margin="0,0,8,8" />
                                    <Button Classes="ghost" Content="{Binding AllReadyApprovalLabel}" Command="{Binding ApproveAllEligibleCommand}"
                                            IsVisible="{Binding ShowBulkDocumentApproval}" Margin="0,0,8,8" />
                                    <Button Classes="secondary" Content="Continuar com os documentos já liberados" Command="{Binding ContinueToDispatchCommand}"
                                            IsEnabled="{Binding CanContinueToDispatch}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Border IsVisible="{Binding ShowSelectedClientApproval}" Background="#F7F1E2" CornerRadius="9" Padding="11,8">
                                    <TextBlock Text="{Binding SelectedClientApprovalHelp}" Foreground="#66532C" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Expander Header="Organização manual — somente se precisar separar ou unir" Padding="16" CornerRadius="12"
                                  IsVisible="{Binding HasVisibleReviewGroups}" IsExpanded="False">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Classes="muted"
                                           Text="O aplicativo já separa automaticamente por cliente, unidade, competência e regra contábil. Abra esta área somente para corrigir uma exceção que você conferiu."
                                           TextWrapping="Wrap" />

                                <Border Classes="soft" IsVisible="{Binding HasReviewSelection}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Separar somente o documento selecionado" FontSize="16" FontWeight="SemiBold" Foreground="#29261F" />
                                        <TextBlock Text="{Binding SelectedReviewDocument.FileName}" Foreground="#8C691B"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted"
                                                   Text="Use quando este arquivo precisa seguir em uma mensagem própria, sem alterar os demais documentos do conjunto."
                                                   TextWrapping="Wrap" />
                                        <TextBox Text="{Binding SplitGroupReason}"
                                                 PlaceholderText="Explique a exceção (mínimo 10 caracteres)" />
                                        <Button Classes="secondary" Content="Separar este documento"
                                                Command="{Binding SplitSelectedDocumentCommand}"
                                                IsEnabled="{Binding CanSplitSelectedDocument}"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="soft">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Unir conjuntos realmente compatíveis" FontSize="16" FontWeight="SemiBold" Foreground="#29261F" />
                                        <TextBlock Classes="muted"
                                                   Text="Somente conjuntos do mesmo cliente, unidade, competência e regra contábil aparecem aqui. Os nomes incluem período, quantidade e tipos para evitar escolhas repetidas ou ambíguas."
                                                   TextWrapping="Wrap" />
                                        <ComboBox ItemsSource="{Binding CompatibleMergeGroupOptions}"
                                                  SelectedItem="{Binding SelectedMergeGroupOption}"
                                                  IsVisible="{Binding HasCompatibleMergeGroups}"
                                                  PlaceholderText="Escolha o conjunto que deve ser unido">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="ui:ManualGroupOption">
                                                    <StackPanel Spacing="2" Margin="0,3">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="#716B60" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Border IsVisible="{Binding !HasCompatibleMergeGroups}" Background="#FFFFFF" CornerRadius="8" Padding="10">
                                            <TextBlock Text="Não há outro conjunto compatível com o documento selecionado. Não é necessário fazer nada."
                                                       Foreground="#716B60" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBox Text="{Binding MergeGroupReason}"
                                                 IsVisible="{Binding HasCompatibleMergeGroups}"
                                                 PlaceholderText="Explique por que estes conjuntos devem ser unidos (mínimo 10 caracteres)" />
                                        <Button Classes="secondary" Content="Unir os conjuntos escolhidos"
                                                Command="{Binding MergeSelectedGroupsCommand}"
                                                IsEnabled="{Binding CanMergeSelectedGroups}"
                                                IsVisible="{Binding HasCompatibleMergeGroups}"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Como o aplicativo identificou este documento" Padding="16" CornerRadius="12"
                                  IsVisible="{Binding HasReviewSelection}" IsExpanded="{Binding IsDocumentRecognitionPanelExpanded}">
                            <StackPanel Spacing="9" Margin="0,12,0,0">
                                <TextBlock Classes="muted" Text="Estes detalhes servem para uma conferência excepcional; não precisam ser preenchidos." TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SelectedReviewDocument.Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="documents:RecognizedField">
                                            <Border Classes="soft" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="9" RowSpacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#29261F" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Evidence.PageNumber, StringFormat='Página {0}'}" Foreground="#777064" FontSize="11" />
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Role, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DisplayValue}" Foreground="#5D574E" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsDispatchSection}" AutomationProperties.Name="Mensagens e envios">
                    <StackPanel Margin="28" Spacing="14" MaxWidth="1080" HorizontalAlignment="Center">
                        <Border Classes="card" Padding="20">
                            <StackPanel Spacing="14">
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
                                        <Border Classes="stepCircle" Classes.current="{Binding IsDispatchPrepareStepCurrent}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                        <TextBlock Text="Preparar" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
                                        <Border Classes="stepCircle" Classes.current="{Binding IsDispatchReviewStepCurrent}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                        <TextBlock Text="Conferir" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
                                        <Border Classes="stepCircle" Classes.current="{Binding IsDispatchApprovalStepCurrent}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                        <TextBlock Text="Aprovar" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                                        <Border Classes="stepCircle" Classes.current="{Binding IsDispatchCompletionStepCurrent}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                        <TextBlock Text="Concluir" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Classes="muted" Text="{Binding DispatchWorkspaceSummary}" TextWrapping="Wrap" />
                                <StackPanel Spacing="5" MaxWidth="390" HorizontalAlignment="Left">
                                    <TextBlock Classes="label" Text="Modo da próxima mensagem" />
                                    <ComboBox ItemsSource="{Binding DispatchOperationModes}" SelectedItem="{Binding SelectedDispatchOperationMode}"
                                              IsEnabled="{Binding CanSelectDispatchOperationMode}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding DispatchModeHelp}" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Background="{Binding DispatchSafetyBackground}" BorderBrush="#D8D2C6" BorderThickness="1" CornerRadius="10" Padding="12"
                                        AutomationProperties.LiveSetting="Polite">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" Opacity="0.92">
                                            <TextBlock Text="!" Foreground="{Binding DispatchSafetyForeground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DispatchSafetyTitle}" Foreground="{Binding DispatchSafetyForeground}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DispatchSafetyMessage}" Foreground="{Binding DispatchSafetyForeground}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="eyebrow" Text="1 · ESCOLHA OS CLIENTES" />
                                <TextBlock Classes="h2" Text="Documentos já liberados para mensagem" />
                                <TextBlock Classes="muted" Text="Cada conjunto reúne os documentos de um cliente, uma unidade e uma regra contábil. Prepare somente o conjunto escolhido ou todos os conjuntos liberados desta competência." TextWrapping="Wrap" />
                                <ListBox Classes="clean" ItemsSource="{Binding VisibleApprovedReviewGroups}" SelectedItem="{Binding SelectedReviewGroup}"
                                         AutomationProperties.Name="Documentos liberados para preparar" MinHeight="90" MaxHeight="190">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="documents:DocumentDispatchGroup">
                                            <Border Classes="soft" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding ClientDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id, Converter={StaticResource ShortIdentifier}, StringFormat='Conjunto {0}'}"
                                                                       Foreground="#8C691B" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding PeriodLabel}" Foreground="#766F62" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding DocumentIds.Count, StringFormat='{}{0} documento(s)'}" Foreground="#766F62" FontSize="11" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding ApprovalSummary}" Foreground="#766F62" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="Liberado" Foreground="#2F733B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border IsVisible="{Binding !HasApprovedGroupsForDispatch}" Background="#F8F5EE" CornerRadius="9" Padding="14">
                                    <TextBlock Text="Ainda não há documentos liberados nesta competência. Volte a Documentos, resolva as pendências e faça a liberação." Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                                </Border>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="primary" Content="Preparar este conjunto" Command="{Binding PrepareSelectedDispatchCommand}" IsEnabled="{Binding CanPrepareSelectedDispatch}" Margin="0,0,8,8" />
                                    <Button Classes="secondary" Content="Preparar todos os clientes liberados" Command="{Binding PrepareApprovedBatchCommand}" IsEnabled="{Binding CanPrepareDispatchBatch}" Margin="0,0,8,8" />
                                    <Button Classes="ghost" Content="Voltar aos documentos" Command="{Binding ShowDocumentsCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Border Height="1" Background="#E5DFD4" Margin="0,3" />
                                <TextBlock Classes="eyebrow" Text="MENSAGENS PREPARADAS" />
                                <TextBlock Classes="muted"
                                           Text="A lista mantém uma mensagem atual por conjunto. Use a busca ou o filtro para localizar rapidamente um cliente, período, assunto ou arquivo."
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                                    <TextBox Text="{Binding DispatchQueueSearchText}"
                                             PlaceholderText="Buscar cliente, período, assunto ou arquivo"
                                             AutomationProperties.Name="Buscar nas mensagens preparadas" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DispatchQueueFilters}"
                                              SelectedItem="{Binding SelectedDispatchQueueFilter}"
                                              AutomationProperties.Name="Filtrar mensagens preparadas">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="ui:DispatchQueueFilterOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="{Binding DispatchQueueSummary}" Foreground="#6B604C" FontSize="12" TextWrapping="Wrap" />
                                <ListBox Classes="clean" ItemsSource="{Binding VisibleDispatchItems}" SelectedItem="{Binding SelectedDispatchItem}" MaxHeight="210" AutomationProperties.Name="Mensagens preparadas">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="dispatch:DispatchItem">
                                            <Border Background="#F8F5EE" BorderBrush="#E5DFD4" BorderThickness="1" Padding="10" Margin="0,0,0,6" CornerRadius="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="3">
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id, Converter={StaticResource ShortIdentifier}, StringFormat='Mensagem {0}'}"
                                                                       Foreground="#8C691B" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding PeriodLabel}" Foreground="#766F62" FontSize="11" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding ClientDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding GroupId, Converter={StaticResource ShortIdentifier}, StringFormat='Conjunto {0}'}"
                                                                       Foreground="#6B5120" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Message.Attachments.Count, StringFormat='{}{0} anexo(s)', FallbackValue='Sem anexos preparados'}"
                                                                       Foreground="#766F62" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Mode, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" FontSize="11" />
                                                        <TextBlock Text="{Binding State, Converter={StaticResource FriendlyText}}" Foreground="#655F55" FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border IsVisible="{Binding ShowDispatchQueueEmptyState}"
                                        Background="#F8F5EE" BorderBrush="#E5DFD4" BorderThickness="1"
                                        CornerRadius="9" Padding="14">
                                    <TextBlock Text="{Binding DispatchQueueEmptyMessage}" Classes="muted"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding !HasSelectedDispatchItem}" Padding="24">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <TextBlock Classes="h2" Text="Prepare ou escolha uma mensagem" TextAlignment="Center" />
                                <TextBlock Classes="muted" Text="A conferência do destinatário, do texto e dos anexos aparecerá aqui, na mesma ordem em que deve ser feita." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="660" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding HasSelectedDispatchItem}" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="eyebrow" Text="2 · CONFIRA DESTINATÁRIO, TEXTO E ANEXOS" />
                                        <TextBlock Text="{Binding SelectedDispatchReference}" Foreground="#8C691B" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Classes="h2" Text="{Binding SelectedDispatchItem.Message.Subject, FallbackValue='Mensagem selecionada'}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDispatchContextSummary}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Preparar outra mensagem" Command="{Binding PrepareAnotherDispatchCommand}" VerticalAlignment="Top" />
                                </Grid>
                                <Border Classes="soft">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="label" Text="Destinatário usado nesta operação" />
                                        <TextBlock Text="{Binding SelectedDispatchItem.Message.EffectiveTo, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="label" Text="Texto da mensagem" />
                                <TextBox Text="{Binding SelectedDispatchItem.Message.TextBody}" IsReadOnly="True" AcceptsReturn="True" MinHeight="180" MaxHeight="360" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDispatchItem.Message.Attachments.Count, StringFormat='Anexos ({0})'}" Foreground="#5D574E" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SelectedDispatchItem.Message.Attachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dispatch:DispatchAttachmentSnapshot">
                                            <Border Classes="soft" Margin="0,0,0,5">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DocumentType, Converter={StaticResource FriendlyText}}" Foreground="#766F62" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding HasSelectedDispatchBlocks}" Padding="20">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="h2" Text="Corrija antes de prosseguir" />
                                <ItemsControl ItemsSource="{Binding SelectedDispatchItem.Blocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dispatch:DispatchBlock">
                                            <Border Background="#FFF6ED" BorderBrush="#E8D3BF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding Message}" Foreground="#5B4B42" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding ShowDispatchApprovalPanel}" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="eyebrow" Text="3 · APROVE DEPOIS DA CONFERÊNCIA" />
                                <TextBlock Classes="h2" Text="Confirmação humana" />
                                <TextBlock Classes="muted" Text="A aprovação confirma o cliente, o destinatário, o texto e os anexos. Ela ainda não executa a ação." TextWrapping="Wrap" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="primary" Content="Aprovar esta mensagem" Command="{Binding ApproveSelectedDispatchCommand}" IsEnabled="{Binding CanApproveSelectedDispatch}" Margin="0,0,8,8" />
                                    <Button Classes="secondary" Content="Aprovar todas as mensagens prontas" Command="{Binding ApproveSelectedDispatchBatchCommand}" IsEnabled="{Binding CanApproveSelectedDispatchBatch}" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding ShowDispatchCompletionPanel}" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="eyebrow" Text="4 · CONCLUA A AÇÃO ESCOLHIDA" />
                                <TextBlock Classes="h2" Text="{Binding DispatchActionLabel}" />
                                <StackPanel IsVisible="{Binding IsSendMode}" Spacing="10">
                                    <Border Classes="soft" Padding="14">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="Somente esta mensagem" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding DispatchConfirmationGuidance}" Foreground="#8C691B" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding SendConfirmationPhrase}" PlaceholderText="Confirmação desta mensagem" />
                                            <Button Classes="primary" Content="Enviar somente esta mensagem" Command="{Binding ExecuteSelectedDispatchCommand}" IsEnabled="{Binding CanExecuteSelectedDispatch}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="soft" Padding="14" IsVisible="{Binding ShowDispatchBatchConfirmation}">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="Todas as mensagens aprovadas desta sequência" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding DispatchBatchConfirmationGuidance}" Foreground="#8C691B" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding BatchSendConfirmationPhrase}" PlaceholderText="Confirmação de todas as mensagens" />
                                            <Button Classes="secondary" Content="Enviar todas as mensagens aprovadas" Command="{Binding ExecuteSelectedDispatchBatchCommand}" IsEnabled="{Binding CanExecuteSelectedDispatchBatch}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <WrapPanel IsVisible="{Binding !IsSendMode}" Orientation="Horizontal">
                                    <Button Classes="primary" Content="{Binding DispatchActionLabel}" Command="{Binding ExecuteSelectedDispatchCommand}" IsEnabled="{Binding CanExecuteSelectedDispatch}" Margin="0,0,8,8" />
                                    <Button Classes="secondary" Content="Concluir todas as mensagens aprovadas" Command="{Binding ExecuteSelectedDispatchBatchCommand}" IsEnabled="{Binding CanExecuteSelectedDispatchBatch}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Border IsVisible="{Binding HasDispatchOutcome}" Background="{Binding DispatchSafetyBackground}"
                                        BorderBrush="#D8D2C6" BorderThickness="1" CornerRadius="12" Padding="14" AutomationProperties.LiveSetting="Assertive">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding DispatchOutcomeTitle}" Foreground="{Binding DispatchSafetyForeground}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DispatchOutcomeMessage}" Foreground="{Binding DispatchSafetyForeground}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel IsVisible="{Binding CanReconcileSelectedDispatch}" Orientation="Horizontal">
                                    <Button Classes="ghost" Content="Conferir situação sem repetir" Command="{Binding ReconcileSelectedDispatchCommand}" IsEnabled="{Binding CanReconcileSelectedDispatch}" Margin="0,0,8,8" />
                                    <Button Classes="ghost" Content="Relatar ocorrência" Command="{Binding StartIncidentForSelectedDispatchCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#EDF5EA" BorderBrush="#BED5BA" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Situação da conexão de e-mail" Foreground="#365C36" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EmailProviderConnectionStatus}" Foreground="#42643E" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="Continuar para relatórios" Command="{Binding ContinueToReportsCommand}" IsEnabled="{Binding CanOpenReports}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsReportsSection}" AutomationProperties.Name="Relatórios">
                    <StackPanel Margin="28" Spacing="16" MaxWidth="1080" HorizontalAlignment="Center">
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="7" HorizontalAlignment="Stretch">
                                <TextBlock Classes="eyebrow" Text="PRESTAÇÃO DE CONTAS" />
                                <TextBlock Classes="h1" Text="Relatório claro para conferência" />
                                <TextBlock Classes="muted" Text="Escolha o recorte aqui sem alterar a competência de trabalho do restante do aplicativo. A planilha serve para análise detalhada e o PDF para leitura e arquivo." TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="eyebrow" Text="1 · ESCOLHA O RECORTE" />
                                <TextBlock Classes="h2" Text="Cliente e período" />
                                <TextBlock Classes="muted" Text="Os dois filtros funcionam juntos. Por exemplo: um cliente específico entre agosto e dezembro." TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <Border Classes="soft" VerticalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="label" Text="1. Quem deve aparecer?" />
                                            <ComboBox ItemsSource="{Binding ReportClientFilters}" SelectedItem="{Binding SelectedReportClientFilter}" />
                                            <ComboBox IsVisible="{Binding IsReportClientScope}"
                                                      ItemsSource="{Binding ReportClients}"
                                                      SelectedItem="{Binding SelectedReportClient}"
                                                      PlaceholderText="Escolha o cliente">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="ui:ClientListRow">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding SelectedReportClientFilter.Help}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Classes="soft" VerticalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="label" Text="2. De qual período?" />
                                            <ComboBox ItemsSource="{Binding ReportScopes}" SelectedItem="{Binding SelectedReportScope}" />

                                        <Grid IsVisible="{Binding IsReportMonthScope}" ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="label" Text="Ano" />
                                                <ComboBox ItemsSource="{Binding ReportYearOptions}" SelectedItem="{Binding SelectedReportYear}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="label" Text="Mês" />
                                                <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding SelectedReportMonth}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel IsVisible="{Binding IsReportYearScope}" Spacing="4" MaxWidth="330" HorizontalAlignment="Left">
                                            <TextBlock Classes="label" Text="Ano" />
                                            <ComboBox ItemsSource="{Binding ReportYearOptions}" SelectedItem="{Binding SelectedReportYear}" />
                                        </StackPanel>

                                            <StackPanel IsVisible="{Binding IsReportRangeScope}" Spacing="8">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="label" Text="Ano inicial" />
                                                        <ComboBox ItemsSource="{Binding ReportYearOptions}" SelectedItem="{Binding SelectedReportStartYear}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Classes="label" Text="Mês inicial" />
                                                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding SelectedReportStartMonth}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="label" Text="Ano final" />
                                                        <ComboBox ItemsSource="{Binding ReportYearOptions}" SelectedItem="{Binding SelectedReportEndYear}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Classes="label" Text="Mês final" />
                                                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding SelectedReportEndMonth}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedReportScope.Help}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Border Background="#FFF6DE" BorderBrush="#E0C578" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <TextBlock Text="{Binding ReportScopeSummary, StringFormat='Recorte escolhido: {0}'}" Foreground="#694B10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Grid.Column="1" Classes="primary" Content="Gerar planilha e PDF" Command="{Binding ExportDispatchReportsCommand}"
                                            IsEnabled="{Binding CanExportReport}" VerticalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="eyebrow" Text="2 · CONFIRA AS COMUNICAÇÕES" />
                                <TextBlock Classes="h2" Text="Situação atual das mensagens no recorte" />
                                <TextBlock Classes="muted" Text="A tela mostra uma mensagem atual por conjunto; as ações e versões anteriores permanecem na auditoria do arquivo. “Aceita pelo serviço” não significa “entregue ao destinatário”." TextWrapping="Wrap" />
                                <Border IsVisible="{Binding !HasReportCommunicationRows}" Classes="soft">
                                    <TextBlock Text="Nenhuma mensagem foi preparada neste recorte. O relatório ainda poderá registrar documentos e pendências existentes." Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding ReportCommunicationRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:CommunicationStatusRow">
                                            <Border Classes="soft" Margin="0,0,0,7">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding MessageReference}" Classes="muted" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Period}" Foreground="#766F62" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding GroupSummary}" Foreground="#6B5120" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DocumentSummary}" Foreground="#514C42" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding OperationResult}" Foreground="#8C691B" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DeliveryStatus}" Foreground="#514C42" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding NextAction, StringFormat='Próxima ação: {0}'}" Classes="muted" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="eyebrow" Text="3 · ARQUIVOS GERADOS" />
                                <TextBlock Classes="h2" Text="Planilha detalhada e PDF organizado" />
                                <TextBlock Text="A planilha contém resumo, clientes, documentos, pendências e linha do tempo. O PDF apresenta os indicadores e as situações de comunicação em formato de leitura." Foreground="#514C42" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <Border Classes="soft">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="label" Text="Pasta de destino" />
                                            <TextBlock Text="{Binding ReportOutputDirectory}" Foreground="#716B60" TextWrapping="Wrap" />
                                            <Button Classes="ghost" Content="Escolher outra pasta" Click="ChooseReportFolder_Click" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="soft">
                                        <StackPanel Spacing="7">
                                            <TextBlock Classes="label" Text="Última planilha" />
                                            <TextBlock Text="{Binding LastReportPath}" Foreground="#716B60" TextWrapping="Wrap" />
                                            <Border Height="1" Background="#E5DFD4" Margin="0,3" />
                                            <TextBlock Classes="label" Text="Último PDF" />
                                            <TextBlock Text="{Binding LastReportPdfPath}" Foreground="#716B60" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Classes="muted" Text="Arquivos CSV auxiliares também são criados para compatibilidade com outros sistemas." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsHistorySection}" AutomationProperties.Name="Histórico e ocorrências">
                    <StackPanel Margin="28" Spacing="14">
                        <Border Classes="card">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="eyebrow" Text="LINHA DO TEMPO" />
                                <TextBlock Classes="h1" Text="O que aconteceu no trabalho" />
                                <TextBlock Classes="muted" Text="Veja as ações do dia a dia em linguagem simples. Filtre por data, cliente ou documento e abra somente a seção que precisa consultar." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="eyebrow" Text="FILTROS DE CONSULTA" />
                                    <TextBlock Classes="h2" Text="Encontre um acontecimento sem percorrer toda a lista" />
                                    <TextBlock Classes="muted" Text="A competência do cabeçalho continua valendo. Estes filtros refinam a consulta do Histórico e não apagam nenhum registro." TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <Border Classes="soft">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="label" Text="Quando aconteceu?" />
                                            <ComboBox ItemsSource="{Binding HistoryTimeScopes}" SelectedItem="{Binding SelectedHistoryTimeScope}" />
                                            <TextBlock Text="{Binding HistoryTimeScopeHelp}" Classes="muted" TextWrapping="Wrap" />
                                            <StackPanel IsVisible="{Binding IsHistoryFilterDay}" Spacing="4">
                                                <TextBlock Classes="label" Text="Dia" />
                                                <DatePicker SelectedDate="{Binding HistoryFilterStartDate}" />
                                            </StackPanel>
                                            <Grid IsVisible="{Binding IsHistoryFilterMonth}" ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="label" Text="Ano" />
                                                    <ComboBox ItemsSource="{Binding HistoryCalendarYears}" SelectedItem="{Binding SelectedHistoryCalendarYear}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Classes="label" Text="Mês" />
                                                    <ComboBox ItemsSource="{Binding HistoryCalendarMonths}" SelectedItem="{Binding SelectedHistoryCalendarMonth}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel IsVisible="{Binding IsHistoryFilterYear}" Spacing="4">
                                                <TextBlock Classes="label" Text="Ano" />
                                                <ComboBox ItemsSource="{Binding HistoryCalendarYears}" SelectedItem="{Binding SelectedHistoryCalendarYear}" />
                                            </StackPanel>
                                            <Grid IsVisible="{Binding IsHistoryFilterCustomInterval}" ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="label" Text="Começa em" />
                                                    <DatePicker SelectedDate="{Binding HistoryFilterStartDate}" />
                                                    <TimePicker SelectedTime="{Binding HistoryFilterStartTime}" ClockIdentifier="24HourClock" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Classes="label" Text="Termina em" />
                                                    <DatePicker SelectedDate="{Binding HistoryFilterEndDate}" />
                                                    <TimePicker SelectedTime="{Binding HistoryFilterEndTime}" ClockIdentifier="24HourClock" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="soft">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="label" Text="De quem e sobre qual documento?" />
                                            <ComboBox ItemsSource="{Binding HistoryClientFilters}" SelectedItem="{Binding SelectedHistoryClientFilter}" />
                                            <ComboBox ItemsSource="{Binding HistoryDocumentFilters}" SelectedItem="{Binding SelectedHistoryDocumentFilter}" />
                                            <TextBlock Classes="label" Text="Palavra ou referência (opcional)" Margin="0,4,0,0" />
                                            <TextBox Text="{Binding HistorySearchText}" PlaceholderText="Ex.: rescisão, BOREAL ou nome do arquivo" />
                                            <TextBlock Classes="muted" Text="Ao escolher um cliente, as alterações do cadastro dele também ficam disponíveis na seção própria." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border IsVisible="{Binding HasHistoryFilterError}" Background="#FFF0ED" BorderBrush="#D99A8C"
                                        BorderThickness="1" CornerRadius="9" Padding="10,8">
                                    <TextBlock Text="{Binding HistoryFilterError}" Foreground="#7A3328" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <Border Background="#FFF6DE" BorderBrush="#E0C578" BorderThickness="1" CornerRadius="10" Padding="11,9">
                                        <TextBlock Text="{Binding HistoryAppliedFilterSummary}" Foreground="#694B10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Grid.Column="1" Classes="primary" Content="Aplicar filtros" Command="{Binding ApplyHistoryFiltersCommand}" VerticalAlignment="Stretch" />
                                    <Button Grid.Column="2" Classes="ghost" Content="Limpar filtros" Command="{Binding ClearHistoryFiltersCommand}" VerticalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border IsVisible="{Binding HasTruncatedHistoryEvents}"
                                Background="#FFF6DE" BorderBrush="#E0C578" BorderThickness="1"
                                CornerRadius="10" Padding="12">
                            <TextBlock Text="{Binding HistoryTruncationMessage}" Foreground="#694B10"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Expander Header="Limpar ou restaurar a visualização" Padding="16" CornerRadius="12" IsExpanded="False">
                            <Border Classes="card" Margin="0,12,0,0">
                                <StackPanel Spacing="12">
                                    <Border Background="#FFF6DE" BorderBrush="#E0C578" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <TextBlock Text="Esta ação somente esconde registros da tela. A auditoria permanece íntegra, protegida e recuperável." Foreground="#694B10" TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Spacing="5" MaxWidth="620" HorizontalAlignment="Left">
                                        <TextBlock Classes="label" Text="Qual parte da linha do tempo deseja ocultar?" />
                                        <ComboBox ItemsSource="{Binding HistoryCleanupScopes}" SelectedItem="{Binding SelectedHistoryCleanupScope}" />
                                        <TextBlock Text="{Binding HistoryCleanupHelp}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding IsHistoryDayCleanup}" Spacing="4" MaxWidth="320" HorizontalAlignment="Left">
                                        <TextBlock Classes="label" Text="Escolha o dia" />
                                        <DatePicker SelectedDate="{Binding HistoryRangeStartDate}" />
                                    </StackPanel>
                                    <Grid IsVisible="{Binding IsHistoryHourCleanup}" ColumnDefinitions="*,*" ColumnSpacing="10" MaxWidth="620" HorizontalAlignment="Left">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="label" Text="Escolha o dia" />
                                            <DatePicker SelectedDate="{Binding HistoryRangeStartDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="label" Text="Escolha o bloco de uma hora" />
                                            <ComboBox ItemsSource="{Binding HistoryHourOptions}" SelectedItem="{Binding SelectedHistoryHour}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="ui:HistoryHourOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid IsVisible="{Binding IsCustomHistoryCleanup}" ColumnDefinitions="*,*" ColumnSpacing="14" MaxWidth="760" HorizontalAlignment="Left">
                                        <StackPanel Spacing="5">
                                            <TextBlock Classes="label" Text="Começa em" />
                                            <DatePicker SelectedDate="{Binding HistoryRangeStartDate}" />
                                            <TimePicker SelectedTime="{Binding HistoryRangeStartTime}" ClockIdentifier="24HourClock" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Classes="label" Text="Termina em" />
                                            <DatePicker SelectedDate="{Binding HistoryRangeEndDate}" />
                                            <TimePicker SelectedTime="{Binding HistoryRangeEndTime}" ClockIdentifier="24HourClock" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="#F3EFE6" CornerRadius="9" Padding="11,9">
                                        <TextBlock Text="{Binding HistoryCleanupSelectionSummary}" Foreground="#514C42" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="{Binding HistoryCleanupActionLabel}" Command="{Binding ArchiveHistoryViewCommand}" Margin="0,0,8,8" />
                                        <Button Classes="ghost" Content="Restaurar todo o histórico" Command="{Binding RestoreHistoryViewCommand}" IsEnabled="{Binding HasHiddenHistoryEvents}" Margin="0,0,8,8" />
                                        <CheckBox Content="Mostrar temporariamente os registros ocultos" IsChecked="{Binding ShowHiddenHistory}"
                                                  IsVisible="{Binding HasHiddenHistoryEvents}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock IsVisible="{Binding HasHiddenHistoryEvents}" Text="{Binding HiddenHistoryEventCount, StringFormat='Ocultos nesta visualização: {0} registro(s).'}" Classes="muted" />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Expander Header="{Binding ReviewHistorySectionHeader}" IsExpanded="{Binding IsReviewHistoryExpanded}"
                                  Padding="16" CornerRadius="12">
                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                <TextBlock Classes="muted" Text="Importações, conferências, correções e liberações documentais no recorte aplicado." TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding VisibleReviewHistoryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:HistoryTimelineRow">
                                            <Border Classes="soft" Margin="0,0,0,6">
                                                <StackPanel Spacing="4">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TimestampUtc, Converter={StaticResource LocalDateTime}}" Foreground="#777064" FontSize="12" Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding Action}" Foreground="#8C691B" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding ClientName}" Foreground="#29261F" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Context}" Foreground="#514C42" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Result}" Foreground="#716B60" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander Header="{Binding DispatchHistorySectionHeader}" IsExpanded="{Binding IsDispatchHistoryExpanded}"
                                  Padding="16" CornerRadius="12">
                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                <TextBlock Classes="muted" Text="Preparação, aprovação, operação no serviço de e-mail e resultado registrado." TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding VisibleDispatchHistoryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:HistoryTimelineRow">
                                            <Border Classes="soft" Margin="0,0,0,6">
                                                <StackPanel Spacing="4">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TimestampUtc, Converter={StaticResource LocalDateTime}}" Foreground="#777064" FontSize="12" Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding Action}" Foreground="#8C691B" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding ClientName}" Foreground="#29261F" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Context}" Foreground="#514C42" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Result}" Foreground="#716B60" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander Header="{Binding CatalogHistoryHeader}" Padding="16" CornerRadius="12">
                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                <TextBlock Classes="muted" Text="Esta seção permanece separada porque alterações cadastrais têm finalidade e retenção diferentes das operações com documentos e mensagens." TextWrapping="Wrap" />
                                <Border IsVisible="{Binding !HasVisibleCatalogAuditEvents}" Classes="soft">
                                    <TextBlock Text="{Binding CatalogHistoryEmptyMessage}" Classes="muted"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding VisibleCatalogAuditEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="contracts:AuditEventModel">
                                            <Border Classes="soft" Margin="0,0,0,6">
                                                <StackPanel Spacing="4">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TimestampUtc, Converter={StaticResource LocalDateTime}}" Foreground="#777064" FontSize="12" Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding Action, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" FontWeight="SemiBold" />
                                                    </WrapPanel>
                                                    <TextBlock Text="Alteração registrada com dados protegidos" Foreground="#514C42" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Relatar ou acompanhar um problema" Padding="16" CornerRadius="12"
                                  AutomationProperties.Name="Registro e acompanhamento de ocorrências">
                            <StackPanel Spacing="18" Margin="0,12,0,0">
                                <StackPanel Spacing="9">
                                    <TextBlock Classes="eyebrow" Text="NOVO RELATO" />
                                    <TextBlock Classes="h2" Text="O que aconteceu?" />
                                    <TextBlock Classes="muted" Text="Use esta área quando uma tentativa tiver resultado incerto. Não repita a ação até conferir o ocorrido." TextWrapping="Wrap" />
                                    <TextBlock Classes="label" Text="Tentativa relacionada" />
                                    <ComboBox ItemsSource="{Binding DeliveryAttempts}" SelectedItem="{Binding SelectedIncidentAttempt}" PlaceholderText="Selecione uma tentativa">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dispatch:DeliveryAttempt">
                                                <TextBlock Text="{Binding StartedAtUtc, StringFormat='Tentativa em {0:g}'}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Tipo de problema" />
                                            <ComboBox ItemsSource="{Binding IncidentCategories}" SelectedItem="{Binding SelectedIncidentCategory}">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:IncidentCategoryOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="label" Text="Urgência" />
                                            <ComboBox ItemsSource="{Binding IncidentSeverities}" SelectedItem="{Binding SelectedIncidentSeverity}">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:IncidentSeverityOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding IncidentSummary}" AcceptsReturn="True" MinHeight="82" MaxLength="2000" PlaceholderText="Descreva o fato e a ação imediata, sem colar documentos ou credenciais" />
                                    <Button Classes="primary" Content="Registrar problema" Command="{Binding OpenIncidentCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Border Height="1" Background="#E5DFD4" />
                                <StackPanel Spacing="9">
                                    <TextBlock Classes="eyebrow" Text="ACOMPANHAMENTO" />
                                    <TextBlock Classes="h2" Text="Providências e solução" />
                                    <ListBox Classes="clean" ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}" MaxHeight="180" AutomationProperties.Name="Problemas registrados">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="incidents:IncidentRecord">
                                                <Border Classes="soft" Margin="0,0,0,5">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Category, Converter={StaticResource FriendlyText}}" Classes="muted" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource FriendlyText}}" Foreground="#8C691B" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Classes="label" Text="Nova situação" />
                                    <ComboBox ItemsSource="{Binding IncidentStatuses}" SelectedItem="{Binding SelectedIncidentStatus}">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:IncidentStatusOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Text="{Binding IncidentTransitionNote}" AcceptsReturn="True" MinHeight="82" MaxLength="2000" PlaceholderText="Informe a providência ou solução aplicada" />
                                    <Button Classes="secondary" Content="Atualizar situação" Command="{Binding TransitionIncidentCommand}" HorizontalAlignment="Left" />
                                    <TextBlock Classes="muted" Text="O histórico não pode ser apagado. Dados fiscais, e-mails e segredos digitados no relato são ocultados antes de salvar." TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsSettingsSection}" AutomationProperties.Name="Configurações">
                    <StackPanel Margin="28" Spacing="14" MaxWidth="1040" HorizontalAlignment="Center">
                        <StackPanel Spacing="14">
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="eyebrow" Text="CONTAS DE E-MAIL" />
                                    <TextBlock Classes="h2" Text="Conecte com segurança" />
                                    <TextBlock Text="{Binding EmailProviderConnectionStatus}" Foreground="#514C42" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding EmailProviderConnectionHelp}" TextWrapping="Wrap" />
                                    <Border Background="#FFF5E4" BorderBrush="#E5C36B" BorderThickness="1" CornerRadius="9" Padding="11">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Por que os botões ainda estão bloqueados?" FontWeight="SemiBold" Foreground="#6C4D11" />
                                            <TextBlock Text="É necessário registrar oficialmente este aplicativo no Google e/ou na Microsoft e configurar o identificador público de cada provedor. Isso não é sua senha e não deve ser improvisado dentro do aplicativo." Classes="muted" TextWrapping="Wrap" />
                                            <TextBlock Text="Enquanto isso, o modo Teste seguro permite conferir o fluxo inteiro sem enviar nada." Foreground="#5E4A1E" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="8">
                                        <Border Classes="soft" BorderBrush="#E2DDD3" BorderThickness="1">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="36,*" ColumnSpacing="9">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="#FFFFFF">
                                                        <TextBlock Text="G" Foreground="#4285F4" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Google Gmail" FontWeight="SemiBold" />
                                                        <TextBlock Text="Suportado pelo aplicativo" Classes="muted" />
                                                    </StackPanel>
                                                </Grid>
                                                <Button Classes="primary" Content="Conectar com Google"
                                                        Command="{Binding ConnectEmailAccountCommand}" IsEnabled="{Binding CanConnectGmail}" />
                                                <TextBlock Classes="muted" Text="O botão será liberado após configurar o registro oficial do Google." TextWrapping="Wrap" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="soft" BorderBrush="#E2DDD3" BorderThickness="1">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="36,*" ColumnSpacing="9">
                                                    <Border Width="34" Height="34" CornerRadius="7" Background="#1473E6">
                                                        <TextBlock Text="O" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Outlook / Microsoft 365" FontWeight="SemiBold" />
                                                        <TextBlock Text="Suportado pelo aplicativo" Classes="muted" />
                                                    </StackPanel>
                                                </Grid>
                                                <Button Classes="primary" Content="Conectar com Microsoft"
                                                        Command="{Binding ConnectEmailAccountCommand}" IsEnabled="{Binding CanConnectMicrosoft}" />
                                                <TextBlock Classes="muted" Text="O botão será liberado após configurar o registro oficial da Microsoft." TextWrapping="Wrap" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox Content="Manter esta conta conectada neste computador" IsChecked="{Binding KeepEmailSession}" />
                                    <TextBlock Classes="muted" Text="A autorização fica no cofre protegido do sistema e nunca é gravada no projeto. Desmarque para desconectar ao fechar o aplicativo." TextWrapping="Wrap" />
                                    <Button Classes="ghost" Content="Desconectar conta atual" Command="{Binding DisconnectEmailAccountCommand}"
                                            IsEnabled="{Binding CanDisconnectEmailAccount}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="eyebrow" Text="CÓPIA DE SEGURANÇA" />
                                    <TextBlock Classes="h2" Text="Cadastros e modelos de mensagem" />
                                    <TextBlock Classes="muted" Text="Inclui: clientes, contatos e modelos de mensagem. Não inclui: PDFs, senhas, tokens, histórico de envios nem o acervo de documentos." TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="Como restaurar: escolha a cópia, confira o resumo e só então confirme a restauração." TextWrapping="Wrap" />
                                    <TextBlock Classes="label" Text="Senha da cópia (mínimo de 12 caracteres)" />
                                    <TextBox PasswordChar="●" Text="{Binding CatalogBackupPassword}" PlaceholderText="Digite somente para salvar ou abrir" />
                                    <TextBlock Classes="muted" Text="A senha não é salva nem pode ser recuperada. Guarde-a separadamente do arquivo." TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Classes="primary" Content="Salvar cópia" Click="SaveCatalogBackup_Click" />
                                        <Button Grid.Column="1" Classes="ghost" Content="Escolher cópia" Click="ChooseCatalogBackup_Click" />
                                    </Grid>
                                    <Border Classes="soft">
                                        <TextBlock Text="{Binding CatalogRestoreSummary}" Foreground="#5E574C" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Classes="secondary" Content="Confirmar restauração" Command="{Binding ConfirmCatalogRestoreCommand}" IsEnabled="{Binding CanApplyCatalogRestore}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="eyebrow" Text="PASTAS DE TRABALHO" />
                                    <TextBlock Classes="h2" Text="Entrada, acervo e relatórios no lugar certo" />
                                    <TextBlock Classes="muted" Text="As pastas e o período selecionado ficam salvos somente neste computador. Cada PDF importado é copiado para o acervo em ano/mês, e conteúdo repetido continua bloqueado pela conferência." TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Pasta de entrada dos PDFs" />
                                        <TextBlock Text="{Binding InputFolderDisplay}" Foreground="#5E574C" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Escolher pasta de entrada" Click="ChooseInputFolder_Click" />
                                </Grid>
                                <Border Height="1" Background="#E5DFD4" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Acervo organizado dos documentos" />
                                        <TextBlock Text="{Binding DocumentArchiveDirectory}" Foreground="#5E574C" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Escolher pasta do acervo" Click="ChooseDocumentArchiveFolder_Click" />
                                </Grid>
                                <Border Height="1" Background="#E5DFD4" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Pasta dos relatórios" />
                                        <TextBlock Text="{Binding ReportOutputDirectory}" Foreground="#5E574C" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Escolher pasta dos relatórios" Click="ChooseReportFolder_Click" />
                                </Grid>
                                <CheckBox Content="Ler também as subpastas da pasta de entrada" IsChecked="{Binding IncludeSubfolders}" />
                            </StackPanel>
                        </Border>

                        <Expander Header="Quando Server, PostgreSQL e login são necessários?" Padding="16" CornerRadius="12">
                            <StackPanel Spacing="8" Margin="0,12,0,0">
                                <TextBlock Text="Neste computador" FontWeight="SemiBold" Foreground="#2F6D3B" />
                                <TextBlock Classes="muted" Text="Clientes, modelos, documentos, conferência, simulação e rascunhos locais funcionam sem Server e sem PostgreSQL." TextWrapping="Wrap" />
                                <TextBlock Text="Perfil compartilhado" FontWeight="SemiBold" Foreground="#8C691B" />
                                <TextBlock Classes="muted" Text="Server é o serviço central que atende vários computadores; PostgreSQL é o banco usado por esse serviço. Eles só são necessários para dados compartilhados, controle central e integrações externas administradas." TextWrapping="Wrap" />
                                <TextBlock Text="Token de acesso" FontWeight="SemiBold" Foreground="#8C691B" />
                                <TextBlock Classes="muted" Text="É uma autorização temporária criada pelo login — nunca algo que o cliente precise inventar ou digitar. O sistema guarda a sessão no cofre protegido do macOS ou Windows." TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Border Classes="card" AutomationProperties.Name="Atualizações do aplicativo">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="ATUALIZAÇÕES" />
                                    <TextBlock Classes="h2" Text="Versões conferidas, no seu ritmo" />
                                    <TextBlock Classes="muted" Text="O aplicativo consulta somente o canal estável. Nada é instalado sem download concluído e sua decisão de reiniciar." TextWrapping="Wrap" />
                                    <Border Classes="soft">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding AppUpdateSummary}" Foreground="#514C42" TextWrapping="Wrap"
                                                       AutomationProperties.Name="Situação da atualização" AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding AppUpdateProgress}" Height="7"
                                                         IsVisible="{Binding IsUpdatingApplication}" AutomationProperties.Name="Progresso da atualização" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Classes="muted" Text="Versões de teste ficam restritas aos detalhes técnicos de suporte e não são oferecidas nesta tela." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                                    <TextBlock Classes="label" Text="Versão instalada" />
                                    <TextBlock Text="{Binding CurrentApplicationVersion, StringFormat='Versão {0}'}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="Canal estável" Margin="0,5,0,0" />
                                    <Button Classes="secondary" Content="Verificar atualização" Command="{Binding CheckForApplicationUpdatesCommand}"
                                            IsEnabled="{Binding CanCheckForUpdates}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Classes="primary" Content="Baixar" Command="{Binding DownloadApplicationUpdateCommand}"
                                                IsEnabled="{Binding CanDownloadApplicationUpdate}" />
                                        <Button Grid.Column="1" Classes="ghost" Content="Aplicar e reiniciar" Command="{Binding ApplyApplicationUpdateCommand}"
                                                IsEnabled="{Binding CanApplyApplicationUpdate}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" AutomationProperties.Name="Revisão de retenção do acervo">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="eyebrow" Text="ORGANIZAÇÃO E RETENÇÃO" />
                                    <TextBlock Classes="h2" Text="Revisar sem excluir automaticamente" />
                                    <TextBlock Classes="muted" Text="O prazo localiza documentos antigos; ele nunca apaga arquivos. A decisão depende das obrigações fiscais, contratuais e da política do escritório." TextWrapping="Wrap" />
                                    <Border Classes="soft"><TextBlock Text="{Binding RetentionReviewSummary}" TextWrapping="Wrap" Foreground="#5E574C" /></Border>
                                </StackPanel>
                                <StackPanel Spacing="8" MaxWidth="360" HorizontalAlignment="Left">
                                    <TextBlock Classes="label" Text="Quando lembrar de revisar" />
                                    <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding SelectedRetentionOption}">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="ui:RetentionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Classes="secondary" Content="Analisar o acervo agora" Command="{Binding ReviewRetentionCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="130,*,180" ColumnSpacing="18">
                                <Border Width="120" Height="92" CornerRadius="10" ClipToBounds="True" Background="#24221E">
                                    <Grid>
                                        <TextBlock Text="Contadores Associados" Foreground="#D4A537" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="10" />
                                        <Image Source="/Assets/Branding/aaa2.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Marca Contadores Associados" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="eyebrow" Text="SOBRE O APLICATIVO" />
                                    <TextBlock Classes="h2" Text="Tecnologia a serviço do cuidado contábil" />
                                    <TextBlock Classes="muted" Text="Folhas da Michelly organiza documentos, reduz tarefas repetitivas e mantém a decisão final com o profissional responsável." TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Height="96" CornerRadius="10" ClipToBounds="True" Background="#EEE9DF">
                                    <Grid>
                                        <TextBlock Text="Equipe do escritório" Foreground="#8C691B" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="/Assets/Branding/aaa1.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Equipe do escritório" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Expander Header="Detalhes técnicos para suporte" Padding="16" CornerRadius="12">
                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                <TextBlock Classes="muted" Text="Esta área é destinada ao proprietário técnico ou ao suporte. Ela não interfere no trabalho cotidiano." TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="Produção gradual e piloto supervisionado são controles de homologação e liberação técnica; não fazem parte do trabalho diário do cliente e permanecem ocultos quando fechados." TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                    <TextBlock Classes="label" Text="Marco de desenvolvimento" />
                                    <TextBlock Grid.Column="1" Text="{Binding Phase}" Foreground="#514C42" />
                                    <TextBlock Grid.Row="1" Classes="label" Text="Ambiente" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Environment}" Foreground="#514C42" />
                                    <TextBlock Grid.Row="2" Classes="label" Text="Integrações" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TechnicalDetails}" Foreground="#514C42" TextWrapping="Wrap" />
                                </Grid>
                                <Expander Header="Produção gradual (uso exclusivo do suporte)" Padding="14" CornerRadius="10"
                                          IsVisible="{Binding IsProductionRolloutVisible}"
                                          AutomationProperties.Name="Prontidão da produção gradual">
                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding ProductionStageLabel}" FontWeight="SemiBold" Foreground="#8C691B" />
                                        <TextBlock Text="{Binding ProductionStatusTitle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProductionStatusSummary}" Classes="muted" TextWrapping="Wrap" />
                                        <Border Classes="soft">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding ProductionPilotGate}" />
                                                <TextBlock Text="{Binding ProductionStableGate}" />
                                                <TextBlock Text="{Binding ProductionBackupGate}" />
                                                <TextBlock Text="{Binding ProductionMonitoringGate}" />
                                                <TextBlock Text="{Binding ProductionIncidentGate}" />
                                                <TextBlock Text="{Binding ProductionSupportGate}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding ProductionLimitsSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ProductionRolesSummary}" Classes="muted" TextWrapping="Wrap" />
                                        <TextBlock Text="Painel informativo: nenhuma trava de produção pode ser aberta por esta tela." Foreground="#2D6535" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Piloto supervisionado (uso exclusivo do suporte)" Padding="14" CornerRadius="10"
                                          IsVisible="{Binding IsPilotMode}"
                                          AutomationProperties.Name="Preparação do piloto supervisionado">
                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding PilotEnvironmentLabel}" FontWeight="SemiBold" Foreground="#8C691B" />
                                        <TextBlock Text="{Binding PilotStatusTitle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PilotStatusSummary}" Classes="muted" TextWrapping="Wrap" />
                                        <Border Classes="soft">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Checklist de homologação" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PilotChecklistProgress, StringFormat='{}{0}%'}" Foreground="#8C691B" FontWeight="SemiBold" />
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding PilotChecklistProgress}" Height="7" />
                                                <TextBlock Text="{Binding PilotMetricsSummary}" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Content="Dados fictícios ou anonimizados conferidos" IsChecked="{Binding PilotNonProductionDataConfirmed}" />
                                        <CheckBox Content="Conta e caixa de teste controladas" IsChecked="{Binding PilotControlledAccountConfirmed}" />
                                        <CheckBox Content="Estação macOS validada" IsChecked="{Binding PilotMacOsStationValidated}" />
                                        <CheckBox Content="Estação Windows validada" IsChecked="{Binding PilotWindowsStationValidated}" />
                                        <CheckBox Content="Cópia e restauração ensaiadas" IsChecked="{Binding PilotBackupRestoreValidated}" />
                                        <CheckBox Content="Reversão para a versão anterior ensaiada" IsChecked="{Binding PilotRollbackValidated}" />
                                        <Border Background="#EAF4E8" CornerRadius="9" Padding="12">
                                            <TextBlock Text="{Binding PilotSafeguardSummary}" Foreground="#2D6535" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                        <Button Classes="primary" Content="Salvar checklist de homologação" Command="{Binding SavePilotChecklistCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Expander>
                                <Border Height="1" Background="#E5DFD4" />
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="label" Text="Simulação de falhas para suporte" />
                                    <TextBlock Classes="muted" Text="Não altere durante o uso normal. Esta opção existe somente para testar recuperação e mensagens de erro sem enviar e-mail real." TextWrapping="Wrap" />
                                    <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding FakeDeliveryScenarios}" SelectedItem="{Binding SelectedFakeDeliveryScenario}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding TestDestination}" PlaceholderText="Caixa de teste" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#FFF9E9" BorderBrush="#E6D7A8" BorderThickness="0,1,0,0" Padding="22,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="●" Foreground="#B58720" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#5E4A1E" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"
                               AutomationProperties.Name="Estado da operação" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
