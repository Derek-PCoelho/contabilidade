# Copie para um cofre de configuração do ambiente; não renomeie para um arquivo versionado com valores reais.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=https://0.0.0.0:8443
AllowedHosts=homologacao.exemplo.invalid
Kestrel__Certificates__Default__Path=/run/secrets/tls-staging.pfx
Kestrel__Certificates__Default__Password=SENHA_DO_COFRE
ConnectionStrings__CentralDatabase=Host=postgres.exemplo.invalid;Port=5432;Database=folhas_staging;Username=USUARIO_DO_COFRE;Password=SENHA_DO_COFRE;SSL Mode=VerifyFull;Root Certificate=/run/secrets/postgresql-ca.pem;Include Error Detail=false

Authentication__Oidc__SigningCertificatePath=/run/secrets/oidc-signing-staging.pfx
Authentication__Oidc__SigningCertificatePassword=SENHA_DO_COFRE
Authentication__Oidc__EncryptionCertificatePath=/run/secrets/oidc-encryption-staging.pfx
Authentication__Oidc__EncryptionCertificatePassword=SENHA_DO_COFRE

Phase10__MinimumSupportedVersion=0.12.0
Phase10__EmailSendEnabled=false
Phase10__BetaChannelEnabled=true
Phase10__StableChannelEnabled=false

Phase11__Enabled=true
Phase11__EnvironmentName=staging
Phase11__AllowTest=true
Phase11__AllowDraft=true
Phase11__AllowSend=false
Phase11__RequireNonProductionData=true
Phase11__MaximumClients=5

# O piloto não exige provedor real. Se uma conta dedicada for homologada, mantenha Send desligado.
Phase7__MicrosoftGraph__EmailSendEnabled=false
Phase8__Gmail__EmailSendEnabled=false
