# Copie para deploy/java/.env e preencha. NUNCA versione o .env.
FOLHAS_VERSION=1.0.0
FOLHAS_ENVIRONMENT=Production
FOLHAS_DB_PASSWORD=troque-por-uma-senha-longa
# Endereço público HTTPS do Server (é o "issuer" do login e o endereço configurado nos Desktops).
FOLHAS_OIDC_ISSUER=https://folhas.seu-escritorio.com.br
# Certificado de assinatura dos tokens (PKCS#12) montado em ./secrets.
FOLHAS_OIDC_SIGNING_CERTIFICATE_PATH=/run/secrets/folhas/oidc-signing.p12
FOLHAS_OIDC_SIGNING_CERTIFICATE_PASSWORD=troque
FOLHAS_ALLOWED_HOSTS=folhas.seu-escritorio.com.br
# IP(s) do proxy TLS que fica na frente do Server (separados por vírgula).
FOLHAS_FORWARDED_HEADERS_KNOWN_PROXIES=172.18.0.1
# Todas as travas de envio real começam desligadas (pendência 4.18). Ver docs/java/DEPLOY.md.
FOLHAS_PHASE10_EMAIL_SEND_ENABLED=false
FOLHAS_PHASE12_ENABLED=false
FOLHAS_PHASE12_STAGE=Closed
